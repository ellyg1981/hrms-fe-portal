# HRMS Staff Portal - API Configuration
# Copy this file to .env and update the values for your backend.

# Base URL for the backend API.
# Use an empty value or a relative path for same-origin requests.
REACT_APP_API_BASE_URL=http://localhost:8080

# Endpoint to fetch the currently logged-in employee's record.
REACT_APP_EMPLOYEE_ME_ENDPOINT=/api/employees/me

# Endpoint to search for an employee by check number and/or NIN.
REACT_APP_EMPLOYEE_SEARCH_ENDPOINT=/api/employees/search

# When 'true', the employee API uses the shared demo employee records instead
# of calling the real backend. Useful for development/sample environments.
REACT_APP_USE_DEMO_EMPLOYEES=true

# Set to 'false' to skip source map generation and suppress source-map warnings
# from packages that do not ship source maps.
GENERATE_SOURCEMAP=false
